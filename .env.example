# Copy to .env and fill in the two API keys.

# Required: speech-to-text and text-to-speech (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Optional but recommended: host personality lines (https://console.groq.com)
# Without it the bot uses built-in template lines; the game works the same.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Deepgram Aura voice
DEEPGRAM_VOICE=aura-2-helena-en

# Match docker-compose.yml
DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory_game
REDIS_URL=redis://localhost:6379/0

# Game tuning
GAME_START_LENGTH=3
GAME_MAX_LENGTH=10
GAME_LIVES=3
